UnpackProjectScreen {
    align-horizontal: center;

    #unpack-layout {
        width: 80;
        max-width: 95%;
        height: auto;
        padding: 2;
        margin: 2 0;
        border: heavy $accent;
    }

    #unpack-title {
        height: auto;
        text-style: bold;
        margin-bottom: 1;
    }

    #unpack-help,
    #unpack-status {
        height: auto;
        margin-bottom: 1;
    }

    #unpack-buttons {
        height: auto;
        align-horizontal: right;
        margin-top: 1;
    }

    #unpack-buttons Button {
        margin-left: 1;
    }
}

MergeUnpackedScreen {
    #merge-layout {
        padding: 1 2;
        height: 1fr;
    }

    #merge-help {
        height: auto;
        margin-bottom: 1;
    }

    #merge-table {
        height: 1fr;
        border: heavy $primary;
    }

    #merge-buttons {
        height: auto;
        align-horizontal: right;
        margin-top: 1;
    }

    #merge-buttons Button {
        margin-left: 1;
    }
}
