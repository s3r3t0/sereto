DeleteConfirmationScreen {
    align: center middle;
    #confirm-dialog {
        width: 50;
        height: auto;
        border: heavy $error;
        padding: 1 2;
        background: $surface;
    }
    #confirm-message {
        width: 1fr;
        margin-bottom: 1;
        text-align: center;
    }
    #confirm-buttons {
        height: auto;
        align: center middle;
    }
}

RecordDetailScreen {
    align: center middle;
    #record-detail-dialog {
        width: 90%;
        height: 90%;
        border: heavy $primary;
        padding: 1 2;
        background: $surface;
    }
    #record-detail-title {
        height: 3;
        content-align: center middle;
        text-style: bold;
    }
    #record-detail-body {
        height: 1fr;
    }
    #record-detail-content {
        width: 100%;
    }
    .record-detail-row {
        width: 100%;
        height: 1;
    }
    .record-detail-icon {
        width: 3;
        height: 1;
    }
    .record-detail-value {
        width: 1fr;
        height: 1;
    }
    #record-detail-buttons {
        height: auto;
        dock: bottom;
        align-horizontal: center;
        padding: 1 0 0 0;
    }
}

ConfigRecordFormScreen {
    align: center middle;
    #config-record-dialog {
        width: 70;
        max-width: 95%;
        height: 90%;
        border: heavy $primary;
        padding: 1 2;
        background: $surface;
    }
    #config-record-title {
        height: 3;
        content-align: center middle;
        text-style: bold;
    }
    #config-record-fields {
        height: 1fr;
        scrollbar-gutter: stable;
    }
    .field-row {
        height: auto;
        margin-bottom: 1;
        align: left middle;
        Label {
            width: 12;
            padding: 1;
            text-align: right;
        }
        Select {
            width: 1fr;
        }
    }
    InputWithLabel {
        margin-bottom: 1;
    }
    Input,
    Select > SelectCurrent {
        background: #292929;
        border: tall #292929;
    }
    Input:focus,
    Select:focus > SelectCurrent {
        border: tall $primary;
    }
    Select > SelectOverlay,
    Select > SelectOverlay:focus {
        background: #292929;
        border: tall $primary;
    }
    Input {
        color: #b8b8b8;
    }
    Input > .input--placeholder,
    Select > SelectCurrent > Static#label,
    Select > SelectCurrent > .arrow {
        color: #a8a8a8;
    }
    Select > SelectCurrent.-has-value > Static#label {
        color: #b8b8b8;
    }
    #config-record-buttons {
        height: auto;
        margin-top: 1;
        align: right middle;
        dock: bottom;
    }
    #config-record-cancel {
        margin-right: 1;
    }
}

ProjectBrowserScreen {
    #browser-layout {
        height: 1fr;
        padding: 1 2;
    }
    #project-select-row {
        height: auto;
        margin-bottom: 1;
        align: left middle;
    }
    #project-select {
        height: auto;
        width: 1fr;
    }
    #version-select {
        height: auto;
        width: 15;
    }
    #new-project-btn {
        height: 3;
        width: 7;
        min-width: 3;
        margin: 0 1 0 1;
        text-align: center;
        content-align: center middle;
    }
    #retest-btn {
        height: 3;
        width: 10;
        min-width: 8;
        text-align: center;
        content-align: center middle;
    }
    #action-bar {
        height: auto;
        margin-bottom: 1;
    }
    .action-btn {
        height: 3;
    }
    #content-panel {
        height: 1fr;
        border: tall $panel;
        padding: 1 2;
        scrollbar-gutter: stable;
    }
    #content-container {
        width: 1fr;
        height: auto;
    }
    .browser-stats-row {
        width: 1fr;
        height: auto;
        margin-bottom: 0;
        align: left middle;
    }
    .browser-stat-box {
        width: auto;
        height: auto;
        margin-right: 2;
        padding: 0;
        border: none;
        align: left middle;
        content-align: left middle;
    }
    .browser-targets-list {
        width: 1fr;
        height: auto;
    }
    .browser-target-item {
        width: 1fr;
        height: auto;
        margin: 1 0 0 0;
    }
    .browser-finding-item {
        width: 1fr;
        height: auto;
    }
}

NewProjectScreen {
    #new-project-layout {
        height: auto;
        padding: 2 4;
        align: center top;
    }
    #new-project-title {
        text-style: bold;
        margin-bottom: 1;
    }
    Rule {
        margin-bottom: 1;
    }
    InputWithLabel {
        margin-bottom: 1;
    }
    #new-project-buttons {
        height: auto;
        margin-top: 1;
        align: right middle;
    }
    #new-project-create {
        margin-right: 1;
    }
}

FindingSearchScreen {
    SearchWidget {
        height: 1fr;
    }
}

ProjectBrowserApp {
    #browser-layout {
        height: 1fr;
    }
    .browser-pane {
        width: 30%;
        min-width: 24;
        border-right: solid $accent;
        scrollbar-gutter: stable;
    }
    #project-tree {
        padding: 1 0;
        background: $background;
    }
    .browser-content-pane {
        width: 1fr;
        padding: 1 2;
        scrollbar-gutter: stable;
    }
}

RenderScreen {
    #render-layout {
        height: 1fr;
        padding: 1 2;
    }
    #render-controls {
        height: auto;
        width: 1fr;
        margin-bottom: 1;
        align: left middle;
    }
    #render-type-select {
        width: 30;
        margin-right: 1;
    }
    #fg-filters {
        height: auto;
        width: auto;
        align: left middle;
        margin-right: 1;
    }
    #fg-target-select {
        width: 25;
        margin-right: 1;
    }
    #fg-group-select {
        width: 25;
        margin-right: 1;
    }
    #fg-target-select > SelectOverlay,
    #fg-group-select > SelectOverlay {
        offset: 26 -3;
    }
    #render-btn {
        width: auto;
        margin-right: 1;
    }
    #render-clean-btn {
        dock: right;
        margin-left: 2;
    }
    #render-log {
        height: 1fr;
        border: tall $panel;
        padding: 0 1;
        scrollbar-gutter: stable;
    }
    #open-pdf-btn {
        width: 1fr;
        margin-top: 1;
    }
}

ConfigScreen {
    #version-bar {
        height: auto;
        padding: 0 2;
        align: left middle;
        background: $panel;
        border-bottom: solid $accent;
        #version-bar-label {
            width: 10;
            padding: 1 1;
            text-align: right;
        }
        Select {
            width: 30;
        }
    }
    #config-tabs {
        height: 1fr;
    }
    .tab-container {
        height: 1fr;
    }
    #general-form,
    #targets-form,
    #dates-form,
    #people-form {
        height: 1fr;
        padding: 1 2;
        scrollbar-gutter: stable;
    }
    #targets-form,
    #dates-form,
    #people-form {
        padding-top: 0;
    }
    #general-buttons {
        height: auto;
        margin-top: 1;
        align: right middle;
    }
    .config-add-row {
        height: auto;
        margin: 1 1 0 0;
        align: right middle;
    }
    InputWithLabel {
        margin-bottom: 1;
        margin-right: 2;
    }
    #targets-list,
    #dates-list,
    #people-list {
        height: auto;
        margin-bottom: 1;
    }
    /* ── Light-table header: Targets/Dates/People tabs ──────────────────────── */
    .table-header {
        height: 3;
        width: 1fr;
        align: left middle;
        /* Right padding reserves space for the body's padding and scrollbar. */
        padding: 0 3 0 0;
        background: $panel;
    }
    .table-header-cell {
        height: 1fr;
        padding: 1 1 0 0;
        text-style: bold;
        content-align: left top;
    }
    .table-header-type {
        width: 20;
    }
    .table-header-name {
        width: 1fr;
    }
    .table-header-category {
        width: 18;
    }
    .table-header-category,
    .table-header-type {
        padding: 1 1 0 2;
    }
    .table-header-start,
    .table-header-end {
        width: 1fr;
    }
    .table-header-add-btn {
        width: 11;
        min-width: 11;
        height: 3;
    }

    /* Shared row-end action buttons (view/edit/remove) across all three tables */
    .config-row-button-hit-area {
        width: auto;
        min-width: 7;
        height: 3;
        padding: 1;
    }

    .config-targets-edit-btn,
    .config-targets-remove-btn,
    .config-date-edit-btn,
    .config-date-remove-btn,
    .config-ppl-edit-btn,
    .config-ppl-remove-btn {
        width: auto;
        min-width: 5;
        height: 1;
        padding: 0;
        text-align: center;
        content-align: center middle;
        border: none;
    }

    /* ── Targets table rows ──────────────────────────────────────────────────── */
    .target-row {
        height: 3;
        width: 1fr;
        align: left middle;
    }
    .target-row:hover,
    .person-row:hover {
        background: $boost;
    }
    .target-category {
        width: 18;
        height: 100%;
        padding: 0 1 0 2;
        content-align: left middle;
    }
    .target-name {
        width: 1fr;
        height: 100%;
        padding: 0 1 0 0;
        content-align: left middle;
        color: $text-muted;
    }

    /* ── Dates table rows ────────────────────────────────────────────────────── */
    .date-row {
        height: 3;
        width: 1fr;
        align: left middle;
    }
    .date-type {
        width: 20;
        height: 100%;
        padding: 0 1 0 2;
        content-align: left middle;
    }
    .date-start,
    .date-end {
        width: 1fr;
        height: 100%;
        padding: 0 1 0 0;
        color: $text-muted;
        content-align: left middle;
    }

    /* ── People table rows ───────────────────────────────────────────────────── */
    .person-row {
        height: 3;
        width: 1fr;
        padding: 0;
        align: left middle;
    }
    .person-type-badge {
        width: 20;
        height: 100%;
        padding: 0 1 0 2;
        content-align: left middle;
    }
    .person-name {
        width: 1fr;
        height: 100%;
        padding: 0 1 0 0;
        content-align: left middle;
        color: $text-muted;
    }
}
